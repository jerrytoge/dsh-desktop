{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^@deepseek-ai\\//"],
      "enabled": true,
      "ignoreUnstable": false,
      "allowedVersions": "!/-alpha(?:\\.|$)/",
      "groupName": "deepseek-harness",
      "groupSlug": "deepseek-harness"
    }
  ]
}