{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.1-rc.2",
  "description": "Minimal Electron shell wrapping the DeepSeek Harness web GUI (macOS prototype)",
  "main": "main.js",
  "private": true,
  "author": "dsh-desktop prototype",
  "scripts": {
    "start": "electron .",
    "smoke": "DSH_SMOKE=1 electron .",
    "test": "node --test test/*.test.js",
    "make-icon": "node scripts/make-icon.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "fetch-electron": "node scripts/fetch-electron.mjs",
    "prepare:build": "node scripts/fetch-electron.mjs",
    "build": "node scripts/fetch-electron.mjs && electron-builder --mac",
    "build:dir": "node scripts/fetch-electron.mjs && electron-builder --mac dir"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "^0.1.2-rc",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.2-rc",
    "@deepseek-ai/dsh-atomic-write": "^0.1.2-rc",
    "@deepseek-ai/dsh-authorization": "^0.1.2-rc",
    "@deepseek-ai/dsh-bash-local": "^0.1.2-rc",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc",
    "@deepseek-ai/dsh-output-retention": "^0.1.2-rc",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.2-rc",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.2-rc",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc",
    "@deepseek-ai/dsh-spill": "^0.1.2-rc",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.2-rc",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc",
    "@deepseek-ai/dsh-workflow": "^0.1.2-rc",
    "@local/dsh-client-ui-settings-desktop": "file:packages/dsh-client-ui-settings-desktop",
    "dshmarket": "1.29.3",
    "js-yaml": "^5.4.0",
    "pnpm": "11.24.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.1-rc.2": true,
    "koffi@3.1.5": true,
    "node-pty@1.2.0-beta.15": true
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
